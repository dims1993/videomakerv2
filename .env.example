# Local SQLite database (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Optional — Google Flow image automation (Playwright / CDP)
GOOGLE_FLOW_PROJECT_URL="https://labs.google/fx/es/tools/flow/project/your-project-id"
GOOGLE_FLOW_CDP_URL="http://127.0.0.1:9222"
# ChatGPT browser batch defaults (composer model picker)
CHATGPT_MODEL="GPT-5.5"
CHATGPT_REASONING="Alta"
GOOGLE_FLOW_CONCURRENT_BATCH_SIZE="4"
GOOGLE_FLOW_SUBMIT_GAP_MS="350"
GOOGLE_FLOW_RESPONSE_TIMEOUT_SEC="180"
GOOGLE_FLOW_POST_READY_MS="3000"
GOOGLE_FLOW_MIN_FILE_BYTES="35000"

# Optional — ElevenLabs voiceover
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_VOICE_ID=""
ELEVENLABS_DEFAULT_MODEL_ID="eleven_multilingual_v2"

# Google Cloud Text-to-Speech (pipeline / Voiceover tab provider=google).
# Prefer an API key with Cloud Text-to-Speech enabled, or a short-lived access token.
GOOGLE_TTS_API_KEY=""
# GOOGLE_TTS_ACCESS_TOKEN=""
# GOOGLE_TTS_DEFAULT_VOICE_ID="en-US-Neural2-A"
# GOOGLE_TTS_DEFAULT_LANGUAGE_CODE="en-US"
# Soft stop for Chirp 3 HD local counter (free tier is 1M chars/month).
# GOOGLE_TTS_CHIRP3_HD_SOFT_LIMIT="950000"

# Local Chatterbox TTS server (devnen/Chatterbox-TTS-Server). Used for voice
# cloning + scene voiceovers when a catalog voice has provider=chatterbox.
# Example: docker/run the server, then point here (default port 8004).
CHATTERBOX_BASE_URL="http://127.0.0.1:8004"

# Local WhisperX forced-alignment HTTP server (word timestamps).
# Expect POST /align multipart: file=<audio>, text=<transcript>, language=en
# → { "words": [ { "word": "...", "start": 0.12, "end": 0.40 }, ... ] }
# (nested segments[].words also accepted). Prefer VideoMaker Start/Stop on the
# subtitle alignment picker, or: cd WhisperX-Server && ./venv/bin/python server.py
WHISPERX_BASE_URL="http://127.0.0.1:8011"
# Optional override if the server lives outside ./WhisperX-Server
# WHISPERX_SERVER_DIR="/absolute/or/relative/path/to/WhisperX-Server"
# WHISPERX_DEVICE="cpu"

# Freesound APIv2 token (https://freesound.org/apiv2/apply) — MUSIC_BED attach
FREESOUND_API_KEY=""

# Optional — FFmpeg binary for draft renders (defaults to `ffmpeg` on PATH)
FFMPEG_PATH="/opt/homebrew/bin/ffmpeg-full"
